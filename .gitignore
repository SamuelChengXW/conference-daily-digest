# Secrets
.env
credentials.json
token.json
# Google Cloud service account keys — these are named after the GCP project
# (e.g. conference-digest-xxxxxxxxxxxx.json), not a fixed filename, so glob
# broadly rather than relying on someone remembering the exact name.
*service-account*.json
conference-digest-*.json
*.iam.gserviceaccount.com.json

# Disposable intermediates
.tmp/*
!.tmp/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Personal exports the user drops in here for review (e.g. a downloaded
# Google Sheet snapshot) — not project source, never belongs in the repo.
*.xlsx
*.xls
