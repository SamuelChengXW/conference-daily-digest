{% if standalone_page %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Conference &amp; CFP Digest</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         max-width: 900px; margin: 0 auto; padding: 24px 16px 64px; line-height: 1.5;
         color: #1a1a1a; background: #ffffff; }
  @media (prefers-color-scheme: dark) {
    body { color: #e8e8e8; background: #14161a; }
    .card { background: #1d2025 !important; border-color: #30343a !important; }
    a { color: #7db8ff !important; }
    .muted { color: #9aa0a8 !important; }
  }
  h1 { font-size: 1.5rem; margin-bottom: 0.2em; }
  .subtitle { color: #666; margin-top: 0; margin-bottom: 1.5em; font-size: 0.9rem; }
  .muted { color: #666; }
  .card { border: 1px solid #e0e0e0; border-radius: 10px; padding: 16px 20px; margin-bottom: 14px; }
  .card h2 { font-size: 1.05rem; margin: 0 0 6px; }
  .card h2 a { text-decoration: none; }
  .card h2 a:hover { text-decoration: underline; }
  .meta-row { font-size: 0.88rem; margin: 3px 0; }
  .badge { display: inline-block; font-size: 0.72rem; font-weight: 600; padding: 2px 9px;
           border-radius: 999px; text-transform: uppercase; letter-spacing: 0.03em; }
  .badge-high { background: #ffe0e0; color: #a30000; }
  .badge-medium { background: #fff3d6; color: #8a5a00; }
  .badge-low { background: #e2f3e5; color: #1c6b2e; }
  @media (prefers-color-scheme: dark) {
    .badge-high { background: #4a1414; color: #ff9a9a; }
    .badge-medium { background: #4a3a10; color: #ffd27a; }
    .badge-low { background: #16351f; color: #8fe0a3; }
  }
  .topics { font-size: 0.82rem; color: #555; }
  .footer-note { margin-top: 2.5em; font-size: 0.82rem; color: #888; }
  .empty { padding: 2em 0; color: #666; }
</style>
</head>
<body>
{% endif %}
<h1>Conference &amp; CFP Digest</h1>
<p class="subtitle">Generated {{ generated_date }} &middot; energy, AI/ML, environment, engineering &amp; economics &middot; sorted by submission deadline</p>

{% if records %}
{% for r in records %}
<div class="card">
  <span class="badge badge-{{ r.urgency }}">{{ r.urgency }} urgency</span>
  <h2><a href="{{ r.url }}">{{ r.title }}</a></h2>
  <div class="meta-row"><strong>Submission deadline:</strong> {{ r.submission_deadline }}{% if r.notification_date %} &middot; <strong>Notification:</strong> {{ r.notification_date }}{% endif %}</div>
  {% if r.conference_start %}<div class="meta-row"><strong>Conference dates:</strong> {{ r.conference_start }}{% if r.conference_end and r.conference_end != r.conference_start %} to {{ r.conference_end }}{% endif %}</div>{% endif %}
  {% if r.location %}<div class="meta-row"><strong>Location:</strong> {{ r.location }} ({{ r.mode }})</div>{% endif %}
  <div class="meta-row topics">Matched topics: {{ r.matched_topics | join(", ") if r.matched_topics else "—" }}</div>
  <div class="meta-row"><a href="{{ r.cfp_url }}">Verify details on official CFP listing &rarr;</a></div>
</div>
{% endfor %}
{% else %}
<p class="empty">No conferences currently match your filters within the deadline window. Check back next week, or widen <code>config/filters.yaml</code>.</p>
{% endif %}

<p class="footer-note">Always double-check the submission deadline on the official CFP page before relying on it here — deadlines sourced from WikiCFP can occasionally be stale.{% if site_url %} Full history at <a href="{{ site_url }}">{{ site_url }}</a>.{% endif %}</p>
{% if standalone_page %}
</body>
</html>
{% endif %}
