# Copy this file to .env for local runs. Never commit the real .env.

# Resend (https://resend.com) — used to send the weekly digest email.
# Sign up with the same address you want to send TO (EMAIL_TO below) — Resend's
# free/sandbox tier can only send to the address you signed up with unless you
# verify a domain, which this project deliberately avoids needing.
RESEND_API_KEY=

# Address the digest gets sent to (must match the Resend account's signup address
# in sandbox mode).
EMAIL_TO=your-address@gmail.com

# Google Sheets running archive (optional — pipeline skips this step
# gracefully if unset). See README.md's "Optional: Google Sheet archive"
# section for the one-time Google Cloud service-account setup.
# Paste the *entire* downloaded service-account JSON key as one value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The target spreadsheet's ID (from its URL, between /d/ and /edit) — must
# be shared with the service account's client_email as Editor.
GOOGLE_SHEET_ID=

# Serper.dev (https://serper.dev, free tier, no card) — search API used to
# find Malaysia-specific conferences (UM/UKM/USM/UPM/UTM etc.) that WikiCFP
# doesn't index. Pipeline skips this step gracefully if unset.
SERPER_API_KEY=

# LLM used to extract structured fields (fee/travel/accommodation, and to
# turn Serper's unstructured search results into conference records) —
# see tools/extract_details.py. Currently Gemini; pipeline skips this step
# gracefully if unset or if the key errors out.
GEMINI_API_KEY=
